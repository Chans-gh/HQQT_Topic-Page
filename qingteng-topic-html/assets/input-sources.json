    {"kind":"spreadsheet","label":"表格/多维表","methods":["connector","parser","export","manual"],"inspect":["工作表/视图范围","行列与表头","公式显示值与口径","筛选/隐藏行列"],"loss_risks":["只读当前视图","公式丢失","合并单元格语义丢失"]},
