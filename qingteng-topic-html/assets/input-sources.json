    {"kind":"image","label":"图片/截图组","methods":["visual","ocr","manual"],"inspect":["文件数与顺序","可见文字","对象与细节","裁切/模糊范围"],"loss_risks":["小字无法辨认","裁切缺少上下文","图片间关系未证实"]},
